{
  "name": "campus-resource-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc --noEmit && vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format:check": "prettier --check src e2e *.ts *.json index.html"
  },
  "dependencies": {
    "element-plus": "2.14.7",
    "pinia": "4.0.3",
    "vue": "3.5.43",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/test-utils": "2.5.1",
    "jsdom": "29.0.1",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "unplugin-vue-components": "32.1.0",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "vue-tsc": "3.3.12"
  }
}

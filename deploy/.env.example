# Copy to .env (ignored); generate separate random values for each environment.
POSTGRES_PASSWORD=replace-with-a-long-random-password
RESOURCE_DB_PASSWORD=replace-with-a-different-random-password
WORKFLOW_DB_PASSWORD=replace-with-another-random-password
MODULE_KEY=replace-with-at-least-32-random-characters
WEB_BIND=127.0.0.1
WEB_PORT=8080
COOKIE_SECURE=false
BUILD_COMMIT=local
# M2 review policy: comma-separated ADMIN account IDs; empty uses role/department rules.
WORKFLOW_APPROVAL_STEPS=2
M2_APPROVAL_TIMEOUT=PT24H
M2_FIRST_REVIEWER_IDS=
M2_FINAL_REVIEWER_IDS=
M2_EXPIRY_SCAN_MS=5000
